# ── App ───────────────────────────────────────────────────────────────────────
# Publicly accessible URL.
# Development: set to your tunnel URL (e.g. https://dev.khord.app)
# Production:  set to your domain (e.g. https://khord.app)
PUBLIC_APP_URL=https://your-tunnel-url.trycloudflare.com

# Display name shown in the UI and page titles.
# Defaults to "Khord" if not set.
# PUBLIC_APP_NAME=Khord

# One-line tagline shown on the home page and browser tab.
# Defaults to "Share music, listen anywhere." if not set.
# PUBLIC_APP_TAGLINE=Share music, listen anywhere.

# ── Spotify ───────────────────────────────────────────────────────────────────
# Create an app at https://developer.spotify.com/dashboard
# Note: the account that owns the app must have an active Spotify Premium subscription.
PUBLIC_SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Apple Music ───────────────────────────────────────────────────────────────
# MusicKit JWT developer token from developer.apple.com → Keys.
# Optional — enables Apple Music playlist import. Requires an Apple Developer
# account ($99/yr). Tokens are valid up to 6 months; regenerate before expiry.
# Can also be entered/updated via the instance admin panel without a server restart.
# After setting, enable in admin panel: Settings → Apple Music playlist import.
# PUBLIC_APPLE_MUSIC_DEV_TOKEN=

# ── YouTube ───────────────────────────────────────────────────────────────────
# YouTube Data API v3 key from https://console.cloud.google.com/
# Required to resolve YouTube Music URLs when sharing songs.
# Enable/disable per instance via the admin panel (Settings → YouTube Music links).
# Warning: search costs 100 quota units/call; free quota is 10,000 units/day (~100 songs/day).
# YOUTUBE_API_KEY=

# ── Theme ─────────────────────────────────────────────────────────────────────
# UI color theme. No rebuild required — restart the app to apply.
#
# Neutral dark:   dark (default), zinc, slate, gray, neutral, stone
# Neutral light:  light, zinc-light, slate-light, neutral-light, stone-light
# Chromatic dark: navy, teal, emerald, rose, violet
# PUBLIC_THEME=dark

# ── Features ──────────────────────────────────────────────────────────────────
# Set to "true" to disable album art thumbnails on song cards.
# Useful if the CDN hosting the images becomes unreliable.
# DISABLE_ALBUM_ART=false

# ── Access control ────────────────────────────────────────────────────────────
# Comma-separated list of email addresses with owner/admin privileges.
# The first account registered with a matching email gets the admin role automatically.
# OWNER_EMAILS=you@example.com

# Maximum number of registered users. 0 = unlimited (default).
# Once reached, new sign-ins are rejected. Adjustable live from the admin panel.
# MAX_USERS=50

# ── Database ──────────────────────────────────────────────────────────────────
# Full path to the SQLite database file.
# Default: /data/khord.db — rarely needs changing for Docker Compose deployments.
# Unraid users: set INDEXER_DB_NAME (filename only) in the container template instead.
# INDEXER_DB_PATH=/data/khord.db

# ── Thumbnail cache ───────────────────────────────────────────────────────────
# Directory for the server-side album art disk cache.
# Default: /data/thumbnails — lives inside the same Docker volume as the database.
# Cache populates lazily on first view; manage size from the admin panel (Admin → Cache).
# THUMBNAIL_CACHE_DIR=/data/thumbnails
