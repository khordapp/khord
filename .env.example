# ── App ───────────────────────────────────────────────────────────────────────
# Publicly accessible URL. Must match the registered OAuth redirect URI.
# Development: set to your tunnel URL (e.g. https://dev.khord.app)
# Production:  set to your domain (e.g. https://khord.app)
PUBLIC_APP_URL=https://your-tunnel-url.trycloudflare.com

# Display name shown in the UI, page titles, and AT Protocol OAuth client metadata.
# Defaults to "Khord" if not set.
# PUBLIC_APP_NAME=Khord

# One-line tagline shown on the home page and browser tab.
# Defaults to "Music, across every platform." if not set.
# PUBLIC_APP_TAGLINE=Music, across every platform.

# Name of the authentication/identity provider shown in sign-in UI copy.
# Defaults to "Bluesky" if not set.
# PUBLIC_AUTH_PROVIDER_NAME=Bluesky

# ── Spotify ───────────────────────────────────────────────────────────────────
# Create an app at https://developer.spotify.com/dashboard
# Note: the account that owns the app must have an active Spotify Premium subscription.
PUBLIC_SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Theme ─────────────────────────────────────────────────────────────────────
# UI color theme. No rebuild required — restart the app to apply.
#
# Neutral dark:   dark (default), zinc, slate, gray, neutral, stone
# Neutral light:  light, zinc-light, slate-light, neutral-light, stone-light
# Chromatic dark: navy, teal, emerald, rose, violet
# Requires a rebuild (or dev server restart) when changed.
# PUBLIC_THEME=dark

# ── Features ──────────────────────────────────────────────────────────────────
# Set to "true" to disable album art thumbnails on song cards.
# Useful if the CDN hosting the images becomes unreliable.
# DISABLE_ALBUM_ART=false

# ── Access control ────────────────────────────────────────────────────────────
# Comma-separated list of AT Protocol DIDs allowed to sign in.
# Leave unset (default) to allow anyone to sign in.
# ALLOWED_DIDS=did:plc:abc123,did:plc:def456

# Maximum number of registered users. 0 = unlimited (default).
# Once reached, new sign-ins are rejected. Requires the SQLite DB to be running.
# MAX_USERS=50

# ── Indexer ───────────────────────────────────────────────────────────────────
# Path to the SQLite database file (shared between app and indexer via Docker volume).
# Default: /data/khord.db — only change if running outside Docker.
# INDEXER_DB_PATH=/data/khord.db

# AT Protocol firehose relay to subscribe to.
# Default: wss://bsky.network (Bluesky's main relay)
# FIREHOSE_RELAY=wss://bsky.network
